{
  "name": "zyne-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:catalog:strict": "ENFORCE_CANONICAL_ASSETS=true node scripts/validate-catalog.mjs",
    "validate:routes": "node scripts/validate-generated-routes.mjs",
    "report:catalog-migration": "node scripts/report-catalog-migration.mjs",
    "build": "npm run validate:catalog && vite build && node scripts/prerender.mjs && node scripts/generate-routes.mjs && npm run validate:routes",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
